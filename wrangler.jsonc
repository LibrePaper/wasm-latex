{
  // Deploy the mirror as static assets. Cloudflare negotiates content
  // encoding at the edge; this does not use custom quality-11 precompression,
  // so cold downloads may be larger than the old sidecar representation.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "latex",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "mirror"
  }
}
