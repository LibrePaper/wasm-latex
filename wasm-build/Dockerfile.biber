# Experimental reproduction of TeXlyre's pinned Biber build recipe.
# The source snapshot and base image are pinned; apt, CPAN downloads, and transitive
# git inputs still need locking before this image can produce release artifacts.
FROM emscripten/emsdk:5.0.4@sha256:ef91f658e0104636cf40a702c99169273969cf04d939f4f08e5d0223965d5788

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl xz-utils autoconf automake libtool pkg-config \
    biber git patch ca-certificates && rm -rf /var/lib/apt/lists/*

COPY third-party/texlyre-biber /src/texlyre-biber
COPY wasm-build/biber-smoke.cjs /src/biber-smoke.cjs
COPY wasm-build/build-biber.sh /src/build-biber.sh
COPY wasm-build/export-biber.sh /src/export-biber.sh
COPY wasm-build/biber-worker.js /src/biber-worker.js
COPY wasm-build/BIBER-REBUILD.md /src/BIBER-REBUILD.md
COPY wasm-build/Dockerfile.biber /src/Dockerfile.biber
COPY tools/biber-build-receipt.mjs /src/biber-build-receipt.mjs
ENV BUILD=/build/biber PERL_VERSION=5.38.2 BIBER_VERSION=2.22 \
    PERL_WASM_PREFIX=/opt/perl-wasm AR=emar MAKEFLAGS=-j4 \
    EMCC_CFLAGS=-Wl,-Map=/build/biber/biber.map
ENTRYPOINT ["bash", "/src/build-biber.sh"]
